<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- DPI awareness comes from app.manifest (WPF); WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DynaIsland</RootNamespace>
    <AssemblyName>DynaIsland</AssemblyName>
    <Version>1.0.0</Version>
    <Product>DynaIsland</Product>
    <Description>An Apple-style Dynamic Island for Windows.</Description>
    <!-- A small always-on overlay doesn't need a background GC thread. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the notification-area icon; keep its types out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
