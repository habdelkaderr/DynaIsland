<Window x:Class="DynaIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DynaIsland.Controls"
        Title="DynaIsland"
        Width="560" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">

    <Grid>
        <!-- Soft shadow drawn behind the island (kept separate so text stays crisp) -->
        <Border x:Name="Shadow" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Width="120" Height="30" CornerRadius="15" Background="Black" IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="16" KernelType="Gaussian"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                Width="120" Height="30" CornerRadius="15" Background="Black"
                BorderBrush="#14FFFFFF" BorderThickness="0.6">
            <Grid x:Name="Stage">

                <!-- Idle: the plain pill -->
                <Grid x:Name="IdleView"/>

                <!-- Hover with nothing playing: clock -->
                <Grid x:Name="ClockView" Width="300" Height="42" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ClockTime" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock x:Name="ClockDate" Grid.Column="1" FontSize="13" Margin="10,1,0,0"
                                   Foreground="{StaticResource SubtleText}" VerticalAlignment="Center"/>
                        <StackPanel x:Name="ClockBattery" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockBatteryText" FontSize="12" Foreground="{StaticResource SubtleText}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ClockBatteryIcon" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Compact now playing: art on the left, bars on the right -->
                <Grid x:Name="CompactView" Width="280" Height="34" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" Margin="7,0,0,0"
                            HorizontalAlignment="Left" Background="#FF2C2C2E">
                        <TextBlock x:Name="CompactArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}"
                                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubtleText}"/>
                    </Border>
                    <c:Visualizer x:Name="CompactBars" HorizontalAlignment="Right" Margin="0,0,12,0" Height="14"
                                  BarCount="4" BarWidth="3" BarGap="2"/>
                </Grid>

                <!-- Peek: shown briefly when a new track starts -->
                <Grid x:Name="PeekView" Width="360" Height="54" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Margin="10,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PeekArt" Width="36" Height="36" CornerRadius="9" Background="#FF2C2C2E">
                            <TextBlock x:Name="PeekArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubtleText}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PeekTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PeekArtist" FontSize="12" Foreground="{StaticResource SubtleText}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <c:Visualizer x:Name="PeekBars" Grid.Column="2" Height="16" BarCount="4" BarWidth="3" BarGap="2"/>
                    </Grid>
                </Grid>

                <!-- Expanded media player -->
                <Grid x:Name="ExpandedView" Width="400" Height="176" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="20,18,20,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ExpArt" CornerRadius="14" Background="#FF2C2C2E">
                                <TextBlock x:Name="ExpArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}"
                                           FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource SubtleText}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ExpSource" FontSize="11" Foreground="{StaticResource FaintText}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,1"/>
                                <TextBlock x:Name="ExpTitle" FontSize="16" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ExpArtist" FontSize="13" Foreground="{StaticResource SubtleText}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <c:Visualizer x:Name="ExpBars" Grid.Column="2" Height="20" BarCount="5" BarWidth="3"
                                          BarGap="2.5" Margin="0,0,4,0"/>
                        </Grid>

                        <Grid x:Name="ExpTimeline" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExpElapsed" FontSize="11" Foreground="{StaticResource SubtleText}"
                                       VerticalAlignment="Center"/>
                            <Grid x:Name="ExpTrack" Grid.Column="1" Height="14" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="OnTrackClicked">
                                <Border Height="5" CornerRadius="2.5" Background="#33FFFFFF" VerticalAlignment="Center"/>
                                <Border x:Name="ExpFill" Height="5" CornerRadius="2.5" Background="White"
                                        VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ExpFillScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="ExpRemaining" Grid.Column="2" FontSize="11" TextAlignment="Right"
                                       Foreground="{StaticResource SubtleText}" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                                    Click="OnPrevious"/>
                            <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                    FontSize="24" Width="48" Height="48" Margin="18,0" Click="OnPlayPause"/>
                            <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                                    Click="OnNext"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Transient alerts: volume, battery, caps lock, clipboard -->
                <Grid x:Name="AlertView" Width="330" Height="44" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Margin="16,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AlertIcon" FontFamily="{StaticResource IconFont}" FontSize="17"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="AlertText" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                   Margin="10,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Grid x:Name="AlertBar" Width="96" Height="5" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border CornerRadius="2.5" Background="#33FFFFFF"/>
                                <Border x:Name="AlertBarFill" CornerRadius="2.5" Background="White"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="AlertBarScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="AlertValue" FontSize="12" Foreground="{StaticResource SubtleText}"
                                       MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
